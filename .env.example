# Copy to .env and set AUTH_SECRET. Names match Azure Container Apps / Key Vault.
# Local Postgres (docker compose): see deploy/README.md
# This template has no app yet — keep names when you add one.

DATABASE_URL="postgresql://app:app@localhost:5432/app"

# SQLite fallback only (not Azure; requires Prisma provider = "sqlite" + allow flag):
# DATABASE_URL="file:./dev.db"

AUTH_SECRET="replace-with-a-long-random-string"
ADMIN_EMAILS="estidley@gmail.com"
LAUNCH_UNLOCK_PRO="true"
BILLING_ENABLED="false"

# --- Azure Blob (photos / ticket attachments). Leave unset → local uploads/ ---
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER="app-uploads"
# PHOTO_UPLOAD_DIR="./uploads"

# --- Azure Communication Services Email (C2: OTP + CS ticket replies) ---
# ACS_EMAIL_CONNECTION_STRING=
# ACS_EMAIL_SENDER="DoNotReply@example.com"

# --- Azure Key Vault (prod secrets live here or in Container Apps secrets) ---
# AZURE_KEY_VAULT_URL=
