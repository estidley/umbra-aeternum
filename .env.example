# Copy to .env and set AUTH_SECRET. Names match Railway service variables.
# Local Postgres (docker compose): see deploy/README.md
# This template has no app yet — keep names when you add one.

DATABASE_URL="postgresql://app:app@localhost:5432/app"

# SQLite fallback only (not Railway; requires Prisma provider = "sqlite" + allow flag):
# DATABASE_URL="file:./dev.db"

AUTH_SECRET="replace-with-a-long-random-string"
ADMIN_EMAILS="estidley@gmail.com"
LAUNCH_UNLOCK_PRO="true"
BILLING_ENABLED="false"

# --- Uploads ---
# Railway: attach a volume at /data and set PHOTO_UPLOAD_DIR="/data/uploads".
# Local: leave unset for ./uploads or set an absolute path.
# Azure Blob stays dormant/optional when AZURE_STORAGE_CONNECTION_STRING is unset.
# PHOTO_UPLOAD_DIR="./uploads"
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER="app-uploads"

# --- Outbound email (Resend HTTPS API is the locked Railway production path) ---
# Verify the product domain in Resend. Sends go to api.resend.com, not SMTP.
# Never commit a real key.
# RESEND_API_KEY=
# EMAIL_FROM="App <noreply@example.com>"

# Optional Gmail SMTP fallback when RESEND_API_KEY is unset (local / soft-beta bridge).
# Leave both unset to keep stub behavior. Never commit a real app password.
# GMAIL_USER="estidley@gmail.com"
# GMAIL_APP_PASSWORD=

# --- Legacy ACS placeholders (superseded; unused by the Railway deployment) ---
# ACS_EMAIL_CONNECTION_STRING=
# ACS_EMAIL_SENDER="DoNotReply@example.com"
