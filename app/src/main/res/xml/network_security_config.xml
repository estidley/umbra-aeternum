<?xml version="1.0" encoding="utf-8"?>
<!-- User-typed http:// base URLs are allowed so a local Hermes can be reached. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>